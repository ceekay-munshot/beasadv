# Copy to .env for local scraper runs (never commit .env). In CI these are
# GitHub Actions repository secrets. The static site never sees any of these.

# --- LLM (structured extraction) ---
# Which provider is primary; the other is the automatic fallback.
LLM_PROVIDER=claude                 # 'claude' (default) or 'mistral'

# Bedrock Claude — Converse REST with a BEARER API KEY (not AWS SigV4)
CLAUDE_BEDROCK_API_KEY=
CLAUDE_BEDROCK_REGION=us-east-1
CLAUDE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Mistral fallback
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Scraping (web pages + PDFs) ---
FIRECRAWL_API_KEY=                  # primary (reads pages AND PDFs)
SCRAPEDO_API_KEY=                   # fallback (fetch/render only)

# --- screener.in (annual reports / financials) ---
SCREENER_EMAIL=
SCREENER_PASSWORD=

# --- Playwright (CI installs Chromium; local defaults to /opt/pw-browsers/chromium) ---
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
