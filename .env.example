# Copy to .env for local scraper runs (never commit .env). In CI these are
# GitHub Actions repository secrets. The static site never sees any of these.

# --- LLM (structured extraction + AI Answers) ---
# Which provider is primary; the others are automatic fallbacks.
LLM_PROVIDER=claude                 # 'claude' (default), 'gemini', or 'mistral'

# Bedrock Claude — Converse REST with a BEARER API KEY (not AWS SigV4)
CLAUDE_BEDROCK_API_KEY=
CLAUDE_BEDROCK_REGION=us-east-1
CLAUDE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Google Gemini (free tier) — the API key is sent in the request URL
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral — MISTRAL_API_KEY_NEW takes precedence over MISTRAL_API_KEY when both set
MISTRAL_API_KEY=
MISTRAL_API_KEY_NEW=
MISTRAL_MODEL=mistral-large-latest

# --- Scraping (web pages + PDFs) ---
FIRECRAWL_API_KEY=                  # primary (reads pages AND PDFs); also powers Trends + reviews
SCRAPEDO_API_KEY=                   # fallback (fetch/render only); routes Google Trends via residential IP

# --- Pull signals (all OPTIONAL; each scraper degrades without them) ---
YOUTUBE_API_KEY=                    # Google API key -> YouTube Data API v3; absent => scrape channel page
INSTAGRAM_USERNAME=                 # burner account for best-effort Instagram follower reads
INSTAGRAM_PASSWORD=                 # absent => try public-profile scrape, else keep last-good

# --- screener.in (annual reports / financials) ---
SCREENER_EMAIL=
SCREENER_PASSWORD=

# --- Playwright (Chromium is auto-resolved: CI install cache, or the sandbox's
#     PLAYWRIGHT_BROWSERS_PATH). Set this only to force a specific chrome binary. ---
# PLAYWRIGHT_CHROMIUM_PATH=
